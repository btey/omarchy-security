#
# The Security Hub daemon, one per desktop user. It holds no privileges:
# anything that needs them goes through omarchy-securityd-helper.service,
# which checks each request with polkit.
#
#   systemctl --user enable --now omarchy-securityd.service

[Unit]
Description=Omarchy Security Hub daemon
Documentation=https://github.com/basecamp/omarchy
PartOf=graphical-session.target
After=graphical-session.target
# The helper is optional: without it the threat module scans /proc and the
# firewall module is unavailable.
After=omarchy-securityd-helper.service

[Service]
Type=notify
ExecStart=/usr/bin/omarchy-securityd
# Re-reads ~/.config/omarchy-security/config.toml (docs/configuration.md).
ExecReload=kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# Plan §4.1 budget is < 40 MB; throttle before that and stop well past it.
# Sandboxed programs run in their own scopes, not in this cgroup.
MemoryHigh=40M
MemoryMax=96M

# No setuid programs, no new capabilities, in the daemon or anything it
# starts. gocryptfs vaults need the setuid fusermount3, so the daemon has
# the user manager start gocryptfs and fusermount3 (systemd-run --user, not
# --scope): they do not inherit this. MemoryDenyWriteExecute is deliberately absent: seccomp filters are
# inherited, and sandboxed programs with a JIT would break. RestrictSUIDSGID
# is absent for the same reason: its filter makes bwrap's mount calls fail
# with ENOSYS ("Can't open source /"), so no sandbox could start.
# NoNewPrivileges still keeps setuid bits from granting anything.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=graphical-session.target
